// Run from examples/school with `elomar test`.
// Names can be imported directly: `use app.module.{a, b}`.
use app.students.{new_student, average, level}
use app.grading.{Level, label}

fn test_average_rounds_to_one_decimal() {
    let s = new_student("Lina", [95, 88, 92])
    assert_eq(average(s), 91.7)
}

fn test_empty_grades_average_zero() {
    assert_eq(average(new_student("New", [])), 0.0)
}

fn test_levels() {
    assert(level(new_student("A", [95])) == Level.Excellent)
    assert(level(new_student("B", [60])) == Level.Good)
    assert(level(new_student("C", [10])) == Level.Weak, "10 is below the pass mark")
}

fn test_labels() {
    assert_eq(label(Level.Good), "good")
}
