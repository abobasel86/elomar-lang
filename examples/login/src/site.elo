// الموقع: الصفحات والحسابات والجلسات.
//
// - تُحفظ كلمات المرور كما ترجعها `تشفير.جزئ_كلمة_مرور` (Argon2id)، لا كما هي.
// - الجلسة معرّف عشوائي (`تشفير.رمز_سري`) في ملف ارتباط لا يقرؤه JavaScript
//   (`خادم.مع_ملف_ارتباط` تضع HttpOnly وSameSite=Lax).
// - كل اسم يظهر في صفحة يُهرَّب، فلا يستطيع اسمٌ أن يحقن HTML.
استخدم قياسي.خادم
استخدم قياسي.بيانات
استخدم قياسي.تشفير

عام دالة جهز(قاعدة: قاعدة_بيانات) -> نتيجة<صحيح, خطأ_بيانات> !{بيانات} {
    أرجع بيانات.شغل(قاعدة, "CREATE TABLE users (name TEXT PRIMARY KEY, hash TEXT NOT NULL); CREATE TABLE sessions (id TEXT PRIMARY KEY, name TEXT NOT NULL)")
}

عام دالة عالج(قاعدة: قاعدة_بيانات, طلب: طلب_ويب) -> رد_ويب !{بيانات} {
    ليكن مسار = "{طلب.الطريقة} {طلب.المسار}"
    أرجع طابق مسار {
        "GET /" => الرئيسية(قاعدة, طلب)
        "GET /register" => صفحة_كاملة("حساب جديد", استمارة("/register", "أنشئ الحساب", ""))
        "GET /login" => صفحة_كاملة("الدخول", استمارة("/login", "ادخل", ""))
        "POST /register" => سجل(قاعدة, خادم.نموذج(طلب))
        "POST /login" => ادخل(قاعدة, خادم.نموذج(طلب))
        "POST /logout" => اخرج(قاعدة, طلب)
        _ => خادم.صفحة(404, "<p>لا توجد صفحة هنا</p>")
    }
}

/// اسم المستخدم الذي جاء منه الطلب، إن كان قد دخل.
عام دالة المستخدم(قاعدة: قاعدة_بيانات, طلب: طلب_ويب) -> اختياري<نص> !{بيانات} {
    ليكن جلسة = طابق خادم.ملفات_ارتباط(طلب).اجلب("session") {
        قيمة(ج) => ج
        لاشيء => أرجع لاشيء
    }
    أرجع طابق بيانات.استعلم_واحدا<نص>(قاعدة, "SELECT name FROM sessions WHERE id = :id", { id: جلسة }) {
        نجاح(اسم) => اسم
        فشل(_) => لاشيء
    }
}

دالة الرئيسية(قاعدة: قاعدة_بيانات, طلب: طلب_ويب) -> رد_ويب {
    أرجع طابق المستخدم(قاعدة, طلب) {
        قيمة(اسم) => صفحة_كاملة("أهلًا {آمن(اسم)}", "<p>هذه صفحتك الخاصة.</p><form method=\"post\" action=\"/logout\"><button>اخرج</button></form>")
        لاشيء => صفحة_كاملة("أهلًا بك", "<p><a href=\"/login\">ادخل</a> أو <a href=\"/register\">أنشئ حسابًا</a>.</p>")
    }
}

دالة سجل(قاعدة: قاعدة_بيانات, حقول: قاموس<نص, نص>) -> رد_ويب {
    ليكن اسم = حقول.اجلب_أو("name", "").شذب()
    ليكن كلمة = حقول.اجلب_أو("password", "")
    إذا اسم.فارغ() || اسم.طول > 40 {
        أرجع أعد_المحاولة(422, "/register", "اكتب اسمًا من 1 إلى 40 حرفًا.")
    }
    إذا كلمة.طول < 8 {
        أرجع أعد_المحاولة(422, "/register", "كلمة المرور 8 أحرف على الأقل.")
    }
    ليكن مخزن = تشفير.جزئ_كلمة_مرور(كلمة)
    أرجع طابق بيانات.شغل(قاعدة, "INSERT INTO users (name, hash) VALUES (:name, :hash)", { name: اسم, hash: مخزن }) {
        نجاح(_) => ابدأ_جلسة(قاعدة, اسم)
        فشل(خطأ_بيانات.قيد(_)) => أعد_المحاولة(409, "/register", "هذا الاسم مستخدم.")
        فشل(خ) => خادم.صفحة(500, "<p>{آمن(خ.الرسالة())}</p>")
    }
}

دالة ادخل(قاعدة: قاعدة_بيانات, حقول: قاموس<نص, نص>) -> رد_ويب {
    ليكن اسم = حقول.اجلب_أو("name", "").شذب()
    ليكن كلمة = حقول.اجلب_أو("password", "")
    ليكن مخزن = طابق بيانات.استعلم_واحدا<نص>(قاعدة, "SELECT hash FROM users WHERE name = :name", { name: اسم }) {
        نجاح(قيمة(م)) => م
        _ => ""
    }
    // الجواب نفسه للاسم المجهول ولكلمة المرور الخاطئة.
    إذا !تشفير.طابق_كلمة_مرور(كلمة, مخزن) {
        أرجع أعد_المحاولة(401, "/login", "الاسم أو كلمة المرور غير صحيحة.")
    }
    أرجع ابدأ_جلسة(قاعدة, اسم)
}

دالة ابدأ_جلسة(قاعدة: قاعدة_بيانات, اسم: نص) -> رد_ويب {
    ليكن جلسة = تشفير.رمز_سري(32)
    أرجع طابق بيانات.شغل(قاعدة, "INSERT INTO sessions (id, name) VALUES (:id, :name)", { id: جلسة, name: اسم }) {
        نجاح(_) => خادم.مع_ملف_ارتباط(خادم.حول("/"), "session", جلسة)
        فشل(خ) => خادم.صفحة(500, "<p>{آمن(خ.الرسالة())}</p>")
    }
}

دالة اخرج(قاعدة: قاعدة_بيانات, طلب: طلب_ويب) -> رد_ويب {
    طابق خادم.ملفات_ارتباط(طلب).اجلب("session") {
        قيمة(جلسة) => {
            بيانات.شغل(قاعدة, "DELETE FROM sessions WHERE id = :id", { id: جلسة })
        }
        لاشيء => {}
    }
    أرجع خادم.مع_ملف_ارتباط(خادم.حول("/"), "session", "")
}

دالة أعد_المحاولة(حالة: صحيح, عنوان: نص, رسالة: نص) -> رد_ويب {
    ليكن رد = صفحة_كاملة("حاول مرة أخرى", "<p class=\"error\">{رسالة}</p>" + استمارة(عنوان, "أرسل", ""))
    أرجع { الحالة: حالة, الترويسات: رد.الترويسات, المحتوى: رد.المحتوى }
}

دالة استمارة(عنوان: نص, زر: نص, اسم: نص) -> نص {
    أرجع "<form method=\"post\" action=\"{عنوان}\"><label>الاسم <input name=\"name\" value=\"{آمن(اسم)}\" required></label><label>كلمة المرور <input name=\"password\" type=\"password\" required></label><button>{زر}</button></form>"
}

دالة صفحة_كاملة(عنوان: نص, محتوى: نص) -> رد_ويب {
    أرجع خادم.صفحة(200, "<!doctype html><html lang=\"ar\" dir=\"rtl\"><meta charset=\"utf-8\"><title>{عنوان}</title><body><h1>{عنوان}</h1>{محتوى}</body></html>")
}

/// النص بعد تهريبه ليوضع داخل HTML بأمان.
عام دالة آمن(كلام: نص) -> نص {
    أرجع كلام.استبدل("&", "&amp;").استبدل("<", "&lt;").استبدل(">", "&gt;").استبدل("\"", "&quot;").استبدل("'", "&#39;")
}
