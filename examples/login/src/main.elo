// موقع بحسابات، مكتوب بالعربية كاملًا: حساب جديد، ودخول، وصفحة خاصة، وخروج.
//
//   elomar run examples/login/src/main.elo
//   ثم افتح http://127.0.0.1:8080 في المتصفح.
//
// البيانات في الذاكرة. لتبقى بعد الإيقاف افتح ملفًا بدل ":memory:"
// واسمح بمجلده في `filesystem_write` في elomar.toml.
استخدم app.site
استخدم قياسي.خادم
استخدم قياسي.بيانات

دالة main() {
    ليكن قاعدة = طابق بيانات.افتح(":memory:") {
        نجاح(ق) => ق
        فشل(خ) => {
            اطبع("تعذر فتح قاعدة البيانات: {خ.الرسالة()}")
            أرجع
        }
    }
    طابق site.جهز(قاعدة) {
        نجاح(_) => {}
        فشل(خ) => {
            اطبع(خ.الرسالة())
            أرجع
        }
    }
    اطبع("الموقع يعمل على http://127.0.0.1:8080 (Ctrl+C للإيقاف)")
    طابق خادم.شغل("127.0.0.1:8080", |طلب| site.عالج(قاعدة, طلب)) {
        نجاح(_) => {}
        فشل(خ) => اطبع("خطأ في الخادم: {خ.الرسالة()}")
    }
}
