// شغّلها من examples/login بـ `elomar test`: يُستدعى الموقع بطلبات تُبنى هنا،
// فلا حاجة إلى شبكة.
استخدم app.site
استخدم قياسي.بيانات

دالة افتح() -> قاعدة_بيانات {
    ليكن قاعدة = طابق بيانات.افتح(":memory:") {
        نجاح(ق) => ق
        فشل(خ) => {
            تأكد(خطأ, خ.الرسالة())
            أرجع افتح()
        }
    }
    تأكد(site.جهز(قاعدة).is_ok())
    أرجع قاعدة
}

دالة طلب(طريقة: نص, مسار: نص, جلسة: نص, محتوى: نص) -> طلب_ويب {
    متغير ترويسات: قاموس<نص, نص> = [:]
    إذا !جلسة.فارغ() {
        ترويسات["cookie"] = "session={جلسة}"
    }
    أرجع { الطريقة: طريقة, المسار: مسار, الاستعلام: [:], الترويسات: ترويسات, المحتوى: محتوى }
}

/// معرّف الجلسة الذي يضعه الرد، أو "" إن لم يضع شيئًا أو حذفها.
دالة جلسة_من(رد: رد_ويب) -> نص {
    ليكن سطر = رد.الترويسات.اجلب_أو("Set-Cookie", "")
    إذا !سطر.يبدأ_ب("session=") {
        أرجع ""
    }
    أرجع سطر.اقتطع(8, سطر.موقع(";").القيمة_أو(سطر.طول))
}

دالة اختبار_التسجيل_والخروج_والدخول() {
    ليكن قاعدة = افتح()
    ليكن رد = site.عالج(قاعدة, طلب("POST", "/register", "", "name=%D9%84%D9%8A%D9%86%D8%A7&password=12345678"))
    تأكد_تساوي(رد.status, 303)
    ليكن جلسة = جلسة_من(رد)
    تأكد_تساوي(جلسة.طول, 64)
    تأكد_تساوي(site.المستخدم(قاعدة, طلب("GET", "/", جلسة, "")), قيمة("لينا"))
    تأكد(site.عالج(قاعدة, طلب("GET", "/", جلسة, "")).body.contains("أهلًا لينا"))

    ليكن خروج = site.عالج(قاعدة, طلب("POST", "/logout", جلسة, ""))
    تأكد(خروج.headers["Set-Cookie"].contains("Max-Age=0"))
    تأكد_تساوي(site.المستخدم(قاعدة, طلب("GET", "/", جلسة, "")), لاشيء)

    ليكن دخول = site.عالج(قاعدة, طلب("POST", "/login", "", "name=لينا&password=12345678"))
    تأكد_تساوي(دخول.status, 303)
    تأكد(جلسة_من(دخول) != جلسة)
}

دالة اختبار_كلمة_خاطئة_واسم_مجهول() {
    ليكن قاعدة = افتح()
    site.عالج(قاعدة, طلب("POST", "/register", "", "name=omar&password=correct-horse"))
    ليكن خطأ_كلمة = site.عالج(قاعدة, طلب("POST", "/login", "", "name=omar&password=wrong-horse"))
    ليكن مجهول = site.عالج(قاعدة, طلب("POST", "/login", "", "name=nobody&password=correct-horse"))
    تأكد_تساوي(خطأ_كلمة.status, 401)
    تأكد_تساوي(مجهول.status, 401)
    تأكد_تساوي(خطأ_كلمة.body, مجهول.body)
    تأكد_تساوي(جلسة_من(خطأ_كلمة), "")
}

دالة اختبار_الاسم_لا_يتكرر_ويُفحص() {
    ليكن قاعدة = افتح()
    تأكد_تساوي(site.عالج(قاعدة, طلب("POST", "/register", "", "name=sara&password=12345678")).status, 303)
    تأكد_تساوي(site.عالج(قاعدة, طلب("POST", "/register", "", "name=sara&password=87654321")).status, 409)
    تأكد_تساوي(site.عالج(قاعدة, طلب("POST", "/register", "", "name=&password=12345678")).status, 422)
    تأكد_تساوي(site.عالج(قاعدة, طلب("POST", "/register", "", "name=ali&password=short")).status, 422)
}

دالة اختبار_كلمات_المرور_لا_تُحفظ() {
    ليكن قاعدة = افتح()
    site.عالج(قاعدة, طلب("POST", "/register", "", "name=lina&password=12345678"))
    ليكن مخزن = بيانات.استعلم_واحدا<نص>(قاعدة, "SELECT hash FROM users WHERE name = 'lina'")
    تأكد(مخزن.القيمة_أو(لاشيء).القيمة_أو("").يبدأ_ب("$argon2id$"))
}

دالة اختبار_الجلسة_المزورة_لا_أحد() {
    ليكن قاعدة = افتح()
    تأكد_تساوي(site.المستخدم(قاعدة, طلب("GET", "/", "made-up", "")), لاشيء)
    تأكد(site.عالج(قاعدة, طلب("GET", "/", "made-up", "")).body.contains("/login"))
}

دالة اختبار_الأسماء_لا_تحقن_HTML() {
    ليكن قاعدة = افتح()
    ليكن رد = site.عالج(قاعدة, طلب("POST", "/register", "", "name=%3Cscript%3E&password=12345678"))
    ليكن صفحة = site.عالج(قاعدة, طلب("GET", "/", جلسة_من(رد), "")).body
    تأكد(صفحة.contains("&lt;script&gt;"))
    تأكد(!صفحة.contains("<script>"))
}
