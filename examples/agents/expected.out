tool: add_note - Adds a note to the list
tool: count_notes - How many notes there are
tool: delete_all - Deletes every note
direct call: added note 1
agent:
  step: owner_name => "Lina"
  approve? notes.add_note {"text":"Review chapter 3"} -> true
