// Built-in functions and types with Arabic names: `اطبع` is `print`,
// `نص` is `String`, `قيمة(x)` is `Some(x)`, and so on. They are not
// reserved: a program may use these names for its own things.
نوع طالب = { الاسم: نص, الدرجة: صحيح }

دالة الأعلى(الطلاب: قائمة<طالب>) -> اختياري<طالب> {
    متغير الأفضل: اختياري<طالب> = لاشيء
    لكل ط في الطلاب {
        الأفضل = طابق الأفضل {
            قيمة(س) => إذا_كان_أعلى(س, ط)
            لاشيء => قيمة(ط)
        }
    }
    أرجع الأفضل
}

دالة إذا_كان_أعلى(أ: طالب, ب: طالب) -> اختياري<طالب> {
    إذا أ.الدرجة >= ب.الدرجة { أرجع قيمة(أ) }
    أرجع قيمة(ب)
}

دالة عدد_من(س: نص) -> نتيجة<صحيح, نص> {
    أرجع طابق حلل_صحيح(س) {
        قيمة(ع) => نجاح(ع)
        لاشيء => فشل("ليس عددًا: {س}")
    }
}

دالة رئيسية() {
    ليكن الطلاب: قائمة<طالب> = [
        { الاسم: "لينا", الدرجة: 95 },
        { الاسم: "عمر", الدرجة: 80 }
    ]
    طابق الأعلى(الطلاب) {
        قيمة(ط) => اطبع("الأعلى:", ط.الاسم)
        لاشيء => اطبع("لا أحد")
    }
    اطبع(عدد_من("42"), عدد_من("س"))
    اطبع(أكبر(3, 7), أصغر(3, 7), مطلق(-5), إلى_نص(1.5), إلى_صحيح(2.9), إلى_عشري(2))
    ليكن م: مجموعة<صحيح> = مجموعة([1, 2, 2, 3])
    اطبع("عناصر المجموعة:", م.length)
    ليكن الأسعار: قاموس<نص, عشري> = ["قهوة": 1.5]
    اطبع(الأسعار)
    ليكن المهلة: مدة = 2s
    اطبع(المهلة)
    تأكد(صح)
    تأكد_تساوي(1 + 1, 2)

    // A name of the program hides the built-in, here only.
    ليكن نص = "متغير اسمه نص"
    اطبع(نص)
}
