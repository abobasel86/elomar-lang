// The whole program with Arabic keywords: `دالة` is `fn`, `ليكن` is `let`,
// `إذا` is `if`, and so on. English and Arabic keywords can be mixed.
استخدم std.json

نوع طالب = { الاسم: String, الدرجة: Int }

تعداد شكل {
    دائرة(Float)
    مستطيل(Float, Float)
}

سمة مساحة {
    دالة المساحة(هذا) -> Float
}

نفذ مساحة لكل شكل {
    دالة المساحة(هذا) -> Float {
        أرجع طابق هذا {
            شكل.دائرة(ن) => 3.14 * ن * ن
            شكل.مستطيل(ع, ط) => ع * ط
        }
    }
}

دالة التقدير(الدرجة: Int) -> String {
    إذا الدرجة >= 90 {
        أرجع "ممتاز"
    } وإلا إذا الدرجة >= 75 {
        أرجع "جيد جدًا"
    }
    أرجع "مقبول"
}

غير_متزامن دالة ضعف(س: Int) -> Int {
    أرجع س * 2
}

غير_متزامن دالة رئيسية() {
    ليكن الطلاب: List<طالب> = [
        { الاسم: "لينا", الدرجة: 95 },
        { الاسم: "عمر", الدرجة: 80 },
        { الاسم: "سارة", الدرجة: 70 }
    ]
    لكل ط في الطلاب {
        print(ط.الاسم, "←", التقدير(ط.الدرجة))
    }

    متغير المجموع = 0
    متغير ع = 0
    طالما صح {
        ع += 1
        إذا ع > 10 { توقف }
        إذا ع % 2 == 0 { تابع }
        المجموع += ع
    }
    print("مجموع الأعداد الفردية حتى 10:", المجموع)
    print("17 قسمة 5 =", 17 قسمة 5)

    لكل ش في [شكل.دائرة(1.0), شكل.مستطيل(2.0, 3.0)] {
        print("المساحة:", ش.المساحة())
    }

    print("الضعف:", انتظر ضعف(21))
    print(json.stringify(الطلاب[0]))
    print(صح && !خطأ)
}
