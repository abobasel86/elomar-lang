// Lists, maps, records and enums, changed in place.

type Point = { x: Int, y: Int }
type Shape = { name: String, points: List<Point> }

enum Tree {
    Leaf(Int)
    Node(Tree, Tree)
}

fn sum(t: Tree) -> Int {
    return match t {
        Tree.Leaf(n) => n
        Tree.Node(l, r) => sum(l) + sum(r)
    }
}

fn build(depth: Int) -> Tree {
    if depth == 0 {
        return Tree.Leaf(1)
    }
    return Tree.Node(build(depth - 1), build(depth - 1))
}

fn main() {
    var s: Shape = { name: "tri", points: [{ x: 0, y: 0 }, { x: 4, y: 0 }] }
    s.points.push({ x: 0, y: 3 })
    s.points[1].y += 7
    s.name = s.name.upper()
    let copy = s
    s.points[0].x = 99
    print(s, copy.points[0].x)

    var grid = [[1, 2], [3, 4]]
    grid[1][0] *= 10
    grid[0].push(5)
    print(grid, grid.length, grid[0].length)

    var counts: Map<String, Int> = [:]
    for w in ["a", "b", "a", "c", "a"] {
        counts[w] = counts.get_or(w, 0) + 1
    }
    counts["b"] += 5
    print(counts, counts.length, counts["a"])

    var tags = set(["x"])
    tags.add("y")
    tags.add("x")
    print(tags, tags.length)

    print(sum(build(6)))
    let t = (1, "two", 3.5)
    print(t.0, t.1, t.2)

    var xs = [5, 3, 8, 1]
    let last = xs.pop()
    xs.insert(0, 7)
    print(xs, last, xs.sorted(), xs.filter(|x| x > 4).map(|x| x * x).sum())
    print("{xs.length} items, first {xs[0]}, half {xs[0] / 2}, int {xs[0] div 2}")
}
