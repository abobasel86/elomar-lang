// `std` is `قياسي`; the error enums, their variants and the fields of the
// records modules give have Arabic names, on those records only.
استخدم قياسي.جيسون
استخدم قياسي.وقت
use std.server

نوع سجلي = { status: صحيح, الحالة: نص }

دالة عالج(ط: طلب_ويب) -> رد_ويب {
    أرجع { الحالة: 201, الترويسات: [:], المحتوى: "{ط.الطريقة} {ط.المسار}" }
}

دالة صنف(خ: خطأ_جيسون) -> نص {
    أرجع طابق خ {
        خطأ_جيسون.جيسون_غير_صالح(_) => "ليس JSON"
        JsonError.TypeMismatch(_) => "نوع آخر"
    }
}

دالة رئيسية() {
    طابق جيسون.حلل<صحيح>("x") {
        نجاح(ع) => اطبع(ع)
        فشل(خ) => اطبع(صنف(خ), خ.النوع())
    }
    اطبع(صنف(خطأ_جيسون.نوع_غير_مطابق("س")))
    ليكن ت = وقت.تاريخ(وقت.اصنع(2026, 11, 27))
    اطبع(ت.السنة, ت.الشهر, ت.اليوم, ت.month)
    ليكن ر = عالج({ method: "GET", path: "/أ", query: [:], headers: [:], body: "" })
    اطبع(ر.الحالة, ر.المحتوى, ر.status)
    ليكن س: سجلي = { status: 1, الحالة: "حقل خاص" }
    اطبع(س.status, س.الحالة)
    ليكن م: مدى = 1..3
    اطبع(م)
}
