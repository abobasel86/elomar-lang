// Standard modules and their functions have Arabic names: `استخدم std.رياضيات`
// is `use std.math`, `رياضيات.جذر` is `math.sqrt`. Either spelling of an
// imported module names it, and a program's own name hides it.
استخدم std.رياضيات
استخدم std.جيسون
استخدم std.ترميز
use std.regex
use std.csv

نوع نقطة = { س: صحيح, ص: صحيح }

دالة اطبع_سطرا(نص_ما: نص) !{إدخال_إخراج} {
    اطبع(نص_ما)
}

دالة مع_متغير() {
    // A variable named like a module hides the module here.
    ليكن رياضيات = "متغير"
    اطبع(رياضيات)
}

دالة رئيسية() {
    اطبع(رياضيات.جذر(16.0), math.sqrt(9.0), رياضيات.أس(2.0, 10.0), رياضيات.باي > 3.0)
    اطبع(رياضيات.جا(0.0), رياضيات.وتر(3.0, 4.0))
    طابق جيسون.حلل<نقطة>("\{\"س\": 1, \"ص\": 2}") {
        نجاح(ن) => اطبع(ن.س + ن.ص, جيسون.إلى_نص(ن))
        فشل(خ) => اطبع(خ)
    }
    اطبع(ترميز.إلى_قاعدة64("مرحبا"), ترميز.من_قاعدة64("2YXYsdit2KjYpw=="))
    اطبع(أنماط.يطابق("[0-9]+", "ع1"), regex.find_all("[0-9]+", "1 و 22"))
    اطبع(جدول.حلل("أ,ب\n1,2"))
    اطبع_سطرا("تم")
    مع_متغير()
}
