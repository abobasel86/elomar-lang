// Passwords are hashed with Argon2id; a new salt each time.
استخدم قياسي.تشفير

دالة سجل(كلمة: نص) -> نص {
    أرجع تشفير.جزئ_كلمة_مرور(كلمة)
}

دالة main() {
    ليكن المخزن = سجل("كلمة سر طويلة")
    اطبع(المخزن.يبدأ_ب("$argon2id$v=19$m=19456,t=2,p=1$"))
    اطبع(المخزن != سجل("كلمة سر طويلة"))
    اطبع(تشفير.طابق_كلمة_مرور("كلمة سر طويلة", المخزن))
    اطبع(تشفير.طابق_كلمة_مرور("كلمة سر طويله", المخزن))
    اطبع(crypto.verify_password("", crypto.hash_password("")))
    اطبع(crypto.verify_password("x", "ليس تجزئة"))
}
