// Methods and `length` have Arabic names: `.أضف` is `.push` on a list and
// `.add` on a set; `.طول` is `.length`. A record field or a method from an
// `impl` with the same name wins.
type سجل = { طول: Int }

trait وصف {
    fn حول(هذا) -> String
}

impl وصف for Int {
    fn حول(هذا) -> String {
        return "عدد {هذا}"
    }
}

fn main() {
    var أعداد = [3, 1, 2]
    أعداد.أضف(5)
    اطبع(أعداد.طول, أعداد.مرتبة(), أعداد.رشح(|س| س > 1).مجموع())
    اطبع(أعداد.حول_بالتوازي(|س| س * 2), أعداد.اطو(0, |أ, ب| أ + ب))
    var م = مجموعة([1, 2])
    م.أضف(3)
    اطبع(م.طول, م.يحتوي(3), م.الكل(|س| س > 0))
    let ق = ["أ": 1, "ب": 2]
    اطبع(ق.اجلب("أ").القيمة_أو(0), ق.اجلب_أو("ج", 9), ق.المفاتيح())
    اطبع("  سلام  ".شذب().طول, "أ،ب".قسم("،"), "ها".كرر(3))
    اطبع(2.4.قرب(), 9.0.جذر(), (-3).مطلق(), 2.أس(10), 1.5.بخانات(2))
    let ن: نتيجة<صحيح, نص> = فشل("لا")
    اطبع(ن.فاشلة(), ن.النجاح().بلا_قيمة(), ن.حول_الفشل(|خ| خ.طول))
    let ر: سجل = { طول: 7 }
    اطبع(ر.طول, 4.حول())
}
