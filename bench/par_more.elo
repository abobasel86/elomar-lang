// `par_sum_by`, `par_max_by`, `par_group_by` and `par_flat_map` over heavy
// keys. Prints each result and its time in ms; compare with
// `ELOMAR_PARALLEL=0`, which runs them like `sum_by`, `max_by`,
// `group_by` and `flat_map`.

use std.time

fn upto(n: Int) -> List<Int> {
    var out: List<Int> = []
    for i in 1..=n {
        out.push(i)
    }
    return out
}

fn collatz(n: Int) -> Int {
    var x = n
    var steps = 0
    while x != 1 {
        if x % 2 == 0 {
            x = x div 2
        } else {
            x = 3 * x + 1
        }
        steps += 1
    }
    return steps
}

fn main() {
    let xs = upto(300000)
    var start = time.now()
    let total = xs.par_sum_by(collatz)
    print("par_sum_by:   {total} in {time.now() - start} ms")
    start = time.now()
    let longest = xs.par_max_by(collatz)
    print("par_max_by:   {longest} in {time.now() - start} ms")
    start = time.now()
    let groups = xs.par_group_by(|n| collatz(n) div 100)
    print("par_group_by: {groups.length} in {time.now() - start} ms")
    start = time.now()
    let pairs = xs.par_flat_map(|n| [n, collatz(n)])
    print("par_flat_map: {pairs.length} in {time.now() - start} ms")
}
