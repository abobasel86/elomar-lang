fn main() {
    var counts: Map<String, Int> = [:]
    let words = ["apple", "banana", "cherry", "date", "elder"]
    for i in 0..100000 {
        let w = words[i % 5]
        counts[w] = counts.get_or(w, 0) + 1
    }
    var s = ""
    for i in 0..20000 {
        s = s + "{i % 10}"
    }
    print(counts, s.length)
}
