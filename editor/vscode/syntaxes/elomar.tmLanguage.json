{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Elomar-Lang",
  "scopeName": "source.elomar",
  "fileTypes": ["elo"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#raw-strings" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#effects" },
    { "include": "#use" },
    { "include": "#arabic-keywords" },
    { "include": "#arabic-builtins" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#types" },
    { "include": "#calls" },
    { "include": "#operators" }
  ],
  "repository": {
    "arabic-builtins": {
      "comment": "Arabic names of built-in functions, constructors, types and standard modules (اطبع is print, نص is String, ملفات is fs)",
      "patterns": [
        {
          "name": "support.function.builtin.elomar",
          "match": "(?<![\\p{L}\\p{N}\\p{M}_])(?:ت[\\p{Mn}ـ]*[اأإآٱ][\\p{Mn}ـ]*ك[\\p{Mn}ـ]*د[\\p{Mn}ـ]*_ت[\\p{Mn}ـ]*س[\\p{Mn}ـ]*[اأإآٱ][\\p{Mn}ـ]*و[\\p{Mn}ـ]*[يى][\\p{Mn}ـ]*|[اأإآٱ][\\p{Mn}ـ]*ل[\\p{Mn}ـ]*[يى][\\p{Mn}ـ]*_ص[\\p{Mn}ـ]*ح[\\p{Mn}ـ]*[يى][\\p{Mn}ـ]*ح[\\p{Mn}ـ]*|[اأإآٱ][\\p{Mn}ـ]*ل[\\p{Mn}ـ]*[يى][\\p{Mn}ـ]*_ع[\\p{Mn}ـ]*ش[\\p{Mn}ـ]*ر[\\p{Mn}ـ]*[يى][\\p{Mn}ـ]*|ح[\\p{Mn}ـ]*ل[\\p{Mn}ـ]*ل[\\p{Mn}ـ]*_ص[\\p{Mn}ـ]*ح[\\p{Mn}ـ]*[يى][\\p{Mn}ـ]*ح[\\p{Mn}ـ]*|ح[\\p{Mn}ـ]*ل[\\p{Mn}ـ]*ل[\\p{Mn}ـ]*_ع[\\p{Mn}ـ]*ش[\\p{Mn}ـ]*ر[\\p{Mn}ـ]*[يى][\\p{Mn}ـ]*|[اأإآٱ][\\p{Mn}ـ]*ل[\\p{Mn}ـ]*[يى][\\p{Mn}ـ]*_ن[\\p{Mn}ـ]*ص[\\p{Mn}ـ]*|م[\\p{Mn}ـ]*ج[\\p{Mn}ـ]*م[\\p{Mn}ـ]*و[\\p{Mn}ـ]*ع[\\p{Mn}ـ]*[ةه][\\p{Mn}ـ]*|[اأإآٱ][\\p{Mn}ـ]*ط[\\p{Mn}ـ]*ب[\\p{Mn}ـ]*ع[\\p{Mn}ـ]*|[اأإآٱ][\\p{Mn}ـ]*ق[\\p{Mn}ـ]*ر[\\p{Mn}ـ]*[اأإآٱ][\\p{Mn}ـ]*|ت[\\p{Mn}ـ]*[اأإآٱ][\\p{Mn}ـ]*ك[\\p{Mn}ـ]*د[\\p{Mn}ـ]*|[اأإآٱ][\\p{Mn}ـ]*ص[\\p{Mn}ـ]*غ[\\p{Mn}ـ]*ر[\\p{Mn}ـ]*|[اأإآٱ][\\p{Mn}ـ]*ك[\\p{Mn}ـ]*ب[\\p{Mn}ـ]*ر[\\p{Mn}ـ]*|م[\\p{Mn}ـ]*ط[\\p{Mn}ـ]*ل[\\p{Mn}ـ]*ق[\\p{Mn}ـ]*|[اأإآٱ][\\p{Mn}ـ]*ل[\\p{Mn}ـ]*ك[\\p{Mn}ـ]*ل[\\p{Mn}ـ]*|م[\\p{Mn}ـ]*[ةه][\\p{Mn}ـ]*ل[\\p{Mn}ـ]*[ةه][\\p{Mn}ـ]*)(?![\\p{L}\\p{N}\\p{M}_])(?=\\s*\\()"
        },
        {
          "name": "support.function.constructor.elomar",
          "match": "(?<![\\p{L}\\p{N}\\p{M}_])(?:ق[\\p{Mn}ـ]*[يى][\\p{Mn}ـ]*م[\\p{Mn}ـ]*[ةه][\\p{Mn}ـ]*|ن[\\p{Mn}ـ]*ج[\\p{Mn}ـ]*[اأإآٱ][\\p{Mn}ـ]*ح[\\p{Mn}ـ]*|ف[\\p{Mn}ـ]*ش[\\p{Mn}ـ]*ل[\\p{Mn}ـ]*)(?![\\p{L}\\p{N}\\p{M}_])(?=\\s*\\()"
        },
        {
          "name": "constant.language.none.elomar",
          "match": "(?<![\\p{L}\\p{N}\\p{M}_])(?:ل[\\p{Mn}ـ]*[اأإآٱ][\\p{Mn}ـ]*ش[\\p{Mn}ـ]*[يى][\\p{Mn}ـ]*ء[\\p{Mn}ـ]*)(?![\\p{L}\\p{N}\\p{M}_])"
        },
        {
          "name": "support.type.builtin.elomar",
          "match": "(?<![\\p{L}\\p{N}\\p{M}_])(?:[اأإآٱ][\\p{Mn}ـ]*خ[\\p{Mn}ـ]*ت[\\p{Mn}ـ]*[يى][\\p{Mn}ـ]*[اأإآٱ][\\p{Mn}ـ]*ر[\\p{Mn}ـ]*[يى][\\p{Mn}ـ]*|م[\\p{Mn}ـ]*ج[\\p{Mn}ـ]*م[\\p{Mn}ـ]*و[\\p{Mn}ـ]*ع[\\p{Mn}ـ]*[ةه][\\p{Mn}ـ]*|م[\\p{Mn}ـ]*ن[\\p{Mn}ـ]*ط[\\p{Mn}ـ]*ق[\\p{Mn}ـ]*[يى][\\p{Mn}ـ]*|ق[\\p{Mn}ـ]*[اأإآٱ][\\p{Mn}ـ]*ئ[\\p{Mn}ـ]*م[\\p{Mn}ـ]*[ةه][\\p{Mn}ـ]*|ق[\\p{Mn}ـ]*[اأإآٱ][\\p{Mn}ـ]*م[\\p{Mn}ـ]*و[\\p{Mn}ـ]*س[\\p{Mn}ـ]*|ن[\\p{Mn}ـ]*ت[\\p{Mn}ـ]*[يى][\\p{Mn}ـ]*ج[\\p{Mn}ـ]*[ةه][\\p{Mn}ـ]*|ص[\\p{Mn}ـ]*ح[\\p{Mn}ـ]*[يى][\\p{Mn}ـ]*ح[\\p{Mn}ـ]*|ع[\\p{Mn}ـ]*ش[\\p{Mn}ـ]*ر[\\p{Mn}ـ]*[يى][\\p{Mn}ـ]*|م[\\p{Mn}ـ]*د[\\p{Mn}ـ]*[ةه][\\p{Mn}ـ]*|ن[\\p{Mn}ـ]*ص[\\p{Mn}ـ]*)(?![\\p{L}\\p{N}\\p{M}_])(?=\\s*(?:<|>|,|\\)|=|\\{|$))"
        },
        {
          "name": "entity.name.namespace.elomar",
          "match": "(?<![\\p{L}\\p{N}\\p{M}_])(?:ر[\\p{Mn}ـ]*[يى][\\p{Mn}ـ]*[اأإآٱ][\\p{Mn}ـ]*ض[\\p{Mn}ـ]*[يى][\\p{Mn}ـ]*[اأإآٱ][\\p{Mn}ـ]*ت[\\p{Mn}ـ]*|ب[\\p{Mn}ـ]*[يى][\\p{Mn}ـ]*[اأإآٱ][\\p{Mn}ـ]*ن[\\p{Mn}ـ]*[اأإآٱ][\\p{Mn}ـ]*ت[\\p{Mn}ـ]*|ب[\\p{Mn}ـ]*[اأإآٱ][\\p{Mn}ـ]*[يى][\\p{Mn}ـ]*ث[\\p{Mn}ـ]*و[\\p{Mn}ـ]*ن[\\p{Mn}ـ]*|ع[\\p{Mn}ـ]*ش[\\p{Mn}ـ]*و[\\p{Mn}ـ]*[اأإآٱ][\\p{Mn}ـ]*ئ[\\p{Mn}ـ]*[يى][\\p{Mn}ـ]*|م[\\p{Mn}ـ]*ل[\\p{Mn}ـ]*ف[\\p{Mn}ـ]*[اأإآٱ][\\p{Mn}ـ]*ت[\\p{Mn}ـ]*|ج[\\p{Mn}ـ]*[يى][\\p{Mn}ـ]*س[\\p{Mn}ـ]*و[\\p{Mn}ـ]*ن[\\p{Mn}ـ]*|[اأإآٱ][\\p{Mn}ـ]*د[\\p{Mn}ـ]*و[\\p{Mn}ـ]*[اأإآٱ][\\p{Mn}ـ]*ت[\\p{Mn}ـ]*|[اأإآٱ][\\p{Mn}ـ]*ن[\\p{Mn}ـ]*م[\\p{Mn}ـ]*[اأإآٱ][\\p{Mn}ـ]*ط[\\p{Mn}ـ]*|ت[\\p{Mn}ـ]*ر[\\p{Mn}ـ]*م[\\p{Mn}ـ]*[يى][\\p{Mn}ـ]*ز[\\p{Mn}ـ]*|ت[\\p{Mn}ـ]*ش[\\p{Mn}ـ]*ف[\\p{Mn}ـ]*[يى][\\p{Mn}ـ]*ر[\\p{Mn}ـ]*|ع[\\p{Mn}ـ]*م[\\p{Mn}ـ]*ل[\\p{Mn}ـ]*[يى][\\p{Mn}ـ]*[ةه][\\p{Mn}ـ]*|ذ[\\p{Mn}ـ]*ك[\\p{Mn}ـ]*[اأإآٱ][\\p{Mn}ـ]*ء[\\p{Mn}ـ]*|و[\\p{Mn}ـ]*ك[\\p{Mn}ـ]*[يى][\\p{Mn}ـ]*ل[\\p{Mn}ـ]*|ن[\\p{Mn}ـ]*ظ[\\p{Mn}ـ]*[اأإآٱ][\\p{Mn}ـ]*م[\\p{Mn}ـ]*|خ[\\p{Mn}ـ]*[اأإآٱ][\\p{Mn}ـ]*د[\\p{Mn}ـ]*م[\\p{Mn}ـ]*|ج[\\p{Mn}ـ]*د[\\p{Mn}ـ]*و[\\p{Mn}ـ]*ل[\\p{Mn}ـ]*|و[\\p{Mn}ـ]*[يى][\\p{Mn}ـ]*ب[\\p{Mn}ـ]*|و[\\p{Mn}ـ]*ق[\\p{Mn}ـ]*ت[\\p{Mn}ـ]*)(?![\\p{L}\\p{N}\\p{M}_])(?=\\s*\\.)"
        }
      ]
    },
    "arabic-keywords": {
      "comment": "Arabic keywords (دالة is fn, ليكن is let, ...), with or without hamza, harakat or tatweel",
      "patterns": [
        {
          "match": "((?<![\\p{L}\\p{N}\\p{M}_])(?:[اأإآٱ][\\p{Mn}ـ]*س[\\p{Mn}ـ]*ت[\\p{Mn}ـ]*خ[\\p{Mn}ـ]*د[\\p{Mn}ـ]*م[\\p{Mn}ـ]*)(?![\\p{L}\\p{N}\\p{M}_]))\\s+([\\p{L}_][\\p{L}\\p{N}\\p{M}_]*(?:\\.[\\p{L}_][\\p{L}\\p{N}\\p{M}_]*)*)",
          "captures": {
            "1": {
              "name": "keyword.other.import.elomar"
            },
            "2": {
              "name": "entity.name.namespace.elomar"
            }
          }
        },
        {
          "match": "((?<![\\p{L}\\p{N}\\p{M}_])(?:د[\\p{Mn}ـ]*[اأإآٱ][\\p{Mn}ـ]*ل[\\p{Mn}ـ]*[ةه][\\p{Mn}ـ]*)(?![\\p{L}\\p{N}\\p{M}_]))\\s+([\\p{L}_][\\p{L}\\p{N}\\p{M}_]*)",
          "captures": {
            "1": {
              "name": "storage.type.function.elomar"
            },
            "2": {
              "name": "entity.name.function.elomar"
            }
          }
        },
        {
          "match": "((?<![\\p{L}\\p{N}\\p{M}_])(?:ن[\\p{Mn}ـ]*و[\\p{Mn}ـ]*ع[\\p{Mn}ـ]*|ت[\\p{Mn}ـ]*ع[\\p{Mn}ـ]*د[\\p{Mn}ـ]*[اأإآٱ][\\p{Mn}ـ]*د[\\p{Mn}ـ]*|س[\\p{Mn}ـ]*م[\\p{Mn}ـ]*[ةه][\\p{Mn}ـ]*)(?![\\p{L}\\p{N}\\p{M}_]))\\s+([\\p{L}_][\\p{L}\\p{N}\\p{M}_]*)",
          "captures": {
            "1": {
              "name": "storage.type.elomar"
            },
            "2": {
              "name": "entity.name.type.elomar"
            }
          }
        },
        {
          "name": "keyword.control.elomar",
          "match": "(?<![\\p{L}\\p{N}\\p{M}_])(?:[اأإآٱ][\\p{Mn}ـ]*ذ[\\p{Mn}ـ]*[اأإآٱ][\\p{Mn}ـ]*|و[\\p{Mn}ـ]*[اأإآٱ][\\p{Mn}ـ]*ل[\\p{Mn}ـ]*[اأإآٱ][\\p{Mn}ـ]*|ط[\\p{Mn}ـ]*[اأإآٱ][\\p{Mn}ـ]*ل[\\p{Mn}ـ]*م[\\p{Mn}ـ]*[اأإآٱ][\\p{Mn}ـ]*|ل[\\p{Mn}ـ]*ك[\\p{Mn}ـ]*ل[\\p{Mn}ـ]*|ف[\\p{Mn}ـ]*[يى][\\p{Mn}ـ]*|ت[\\p{Mn}ـ]*و[\\p{Mn}ـ]*ق[\\p{Mn}ـ]*ف[\\p{Mn}ـ]*|ت[\\p{Mn}ـ]*[اأإآٱ][\\p{Mn}ـ]*ب[\\p{Mn}ـ]*ع[\\p{Mn}ـ]*|[اأإآٱ][\\p{Mn}ـ]*ر[\\p{Mn}ـ]*ج[\\p{Mn}ـ]*ع[\\p{Mn}ـ]*|ط[\\p{Mn}ـ]*[اأإآٱ][\\p{Mn}ـ]*ب[\\p{Mn}ـ]*ق[\\p{Mn}ـ]*|[اأإآٱ][\\p{Mn}ـ]*ن[\\p{Mn}ـ]*ت[\\p{Mn}ـ]*ظ[\\p{Mn}ـ]*ر[\\p{Mn}ـ]*)(?![\\p{L}\\p{N}\\p{M}_])"
        },
        {
          "name": "storage.type.elomar",
          "match": "(?<![\\p{L}\\p{N}\\p{M}_])(?:ل[\\p{Mn}ـ]*[يى][\\p{Mn}ـ]*ك[\\p{Mn}ـ]*ن[\\p{Mn}ـ]*|م[\\p{Mn}ـ]*ت[\\p{Mn}ـ]*غ[\\p{Mn}ـ]*[يى][\\p{Mn}ـ]*ر[\\p{Mn}ـ]*|د[\\p{Mn}ـ]*[اأإآٱ][\\p{Mn}ـ]*ل[\\p{Mn}ـ]*[ةه][\\p{Mn}ـ]*|ن[\\p{Mn}ـ]*و[\\p{Mn}ـ]*ع[\\p{Mn}ـ]*|ت[\\p{Mn}ـ]*ع[\\p{Mn}ـ]*د[\\p{Mn}ـ]*[اأإآٱ][\\p{Mn}ـ]*د[\\p{Mn}ـ]*|س[\\p{Mn}ـ]*م[\\p{Mn}ـ]*[ةه][\\p{Mn}ـ]*|ن[\\p{Mn}ـ]*ف[\\p{Mn}ـ]*ذ[\\p{Mn}ـ]*)(?![\\p{L}\\p{N}\\p{M}_])"
        },
        {
          "name": "storage.modifier.elomar",
          "match": "(?<![\\p{L}\\p{N}\\p{M}_])(?:ع[\\p{Mn}ـ]*[اأإآٱ][\\p{Mn}ـ]*م[\\p{Mn}ـ]*|غ[\\p{Mn}ـ]*[يى][\\p{Mn}ـ]*ر[\\p{Mn}ـ]*_م[\\p{Mn}ـ]*ت[\\p{Mn}ـ]*ز[\\p{Mn}ـ]*[اأإآٱ][\\p{Mn}ـ]*م[\\p{Mn}ـ]*ن[\\p{Mn}ـ]*)(?![\\p{L}\\p{N}\\p{M}_])"
        },
        {
          "name": "keyword.other.import.elomar",
          "match": "(?<![\\p{L}\\p{N}\\p{M}_])(?:[اأإآٱ][\\p{Mn}ـ]*س[\\p{Mn}ـ]*ت[\\p{Mn}ـ]*خ[\\p{Mn}ـ]*د[\\p{Mn}ـ]*م[\\p{Mn}ـ]*)(?![\\p{L}\\p{N}\\p{M}_])"
        },
        {
          "name": "keyword.operator.word.elomar",
          "match": "(?<![\\p{L}\\p{N}\\p{M}_])(?:ق[\\p{Mn}ـ]*س[\\p{Mn}ـ]*م[\\p{Mn}ـ]*[ةه][\\p{Mn}ـ]*)(?![\\p{L}\\p{N}\\p{M}_])"
        },
        {
          "name": "variable.language.self.elomar",
          "match": "(?<![\\p{L}\\p{N}\\p{M}_])(?:[ةه][\\p{Mn}ـ]*ذ[\\p{Mn}ـ]*[اأإآٱ][\\p{Mn}ـ]*)(?![\\p{L}\\p{N}\\p{M}_])"
        },
        {
          "name": "keyword.other.reserved.elomar",
          "match": "(?<![\\p{L}\\p{N}\\p{M}_])(?:ب[\\p{Mn}ـ]*ص[\\p{Mn}ـ]*ف[\\p{Mn}ـ]*[ةه][\\p{Mn}ـ]*)(?![\\p{L}\\p{N}\\p{M}_])"
        },
        {
          "name": "constant.language.boolean.elomar",
          "match": "(?<![\\p{L}\\p{N}\\p{M}_])(?:ص[\\p{Mn}ـ]*ح[\\p{Mn}ـ]*|خ[\\p{Mn}ـ]*ط[\\p{Mn}ـ]*[اأإآٱ][\\p{Mn}ـ]*)(?![\\p{L}\\p{N}\\p{M}_])"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.elomar",
          "match": "//.*$"
        },
        {
          "name": "comment.block.elomar",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "raw-strings": {
      "patterns": [
        { "name": "string.quoted.raw.elomar", "begin": "\\br#\"", "end": "\"#|$" },
        { "name": "string.quoted.raw.elomar", "begin": "\\br\"", "end": "\"|$" }
      ]
    },
    "strings": {
      "name": "string.quoted.double.elomar",
      "begin": "\"",
      "end": "\"|$",
      "patterns": [
        {
          "name": "constant.character.escape.elomar",
          "match": "\\\\(?:[ntr0\"\\\\{}]|u\\{[0-9A-Fa-f]{1,6}\\})"
        },
        {
          "name": "invalid.illegal.escape.elomar",
          "match": "\\\\."
        },
        {
          "name": "meta.interpolation.elomar",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.elomar" } },
          "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.elomar" } },
          "contentName": "source.elomar.embedded",
          "patterns": [{ "include": "#interpolation-braces" }, { "include": "$self" }]
        }
      ]
    },
    "interpolation-braces": {
      "begin": "\\{",
      "end": "\\}",
      "patterns": [{ "include": "#interpolation-braces" }, { "include": "$self" }]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.duration.elomar",
          "match": "\\b[0-9][0-9_]*(?:ms|s|m|h)\\b"
        },
        {
          "name": "constant.numeric.float.elomar",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*(?:[eE][+-]?[0-9]+)?\\b|\\b[0-9][0-9_]*[eE][+-]?[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.elomar",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "effects": {
      "comment": "Effect sets such as !{ai, net}",
      "begin": "(!)\\s*(\\{)",
      "beginCaptures": {
        "1": { "name": "keyword.operator.effect.elomar" },
        "2": { "name": "punctuation.definition.effects.begin.elomar" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation.definition.effects.end.elomar" }
      },
      "patterns": [
        {
          "name": "storage.modifier.effect.elomar",
          "match": "\\b(?:io|fs|net|ai|db|py|mcp|process)\\b"
        },
        {
          "name": "storage.modifier.effect.elomar",
          "match": "(?<![\\p{L}\\p{N}\\p{M}_])(?:[اأإآٱ][\\p{Mn}ـ]*د[\\p{Mn}ـ]*خ[\\p{Mn}ـ]*[اأإآٱ][\\p{Mn}ـ]*ل[\\p{Mn}ـ]*_[اأإآٱ][\\p{Mn}ـ]*خ[\\p{Mn}ـ]*ر[\\p{Mn}ـ]*[اأإآٱ][\\p{Mn}ـ]*ج[\\p{Mn}ـ]*|ب[\\p{Mn}ـ]*[يى][\\p{Mn}ـ]*[اأإآٱ][\\p{Mn}ـ]*ن[\\p{Mn}ـ]*[اأإآٱ][\\p{Mn}ـ]*ت[\\p{Mn}ـ]*|ب[\\p{Mn}ـ]*[اأإآٱ][\\p{Mn}ـ]*[يى][\\p{Mn}ـ]*ث[\\p{Mn}ـ]*و[\\p{Mn}ـ]*ن[\\p{Mn}ـ]*|م[\\p{Mn}ـ]*ل[\\p{Mn}ـ]*ف[\\p{Mn}ـ]*[اأإآٱ][\\p{Mn}ـ]*ت[\\p{Mn}ـ]*|[اأإآٱ][\\p{Mn}ـ]*د[\\p{Mn}ـ]*و[\\p{Mn}ـ]*[اأإآٱ][\\p{Mn}ـ]*ت[\\p{Mn}ـ]*|ع[\\p{Mn}ـ]*م[\\p{Mn}ـ]*ل[\\p{Mn}ـ]*[يى][\\p{Mn}ـ]*[ةه][\\p{Mn}ـ]*|ش[\\p{Mn}ـ]*ب[\\p{Mn}ـ]*ك[\\p{Mn}ـ]*[ةه][\\p{Mn}ـ]*|ذ[\\p{Mn}ـ]*ك[\\p{Mn}ـ]*[اأإآٱ][\\p{Mn}ـ]*ء[\\p{Mn}ـ]*)(?![\\p{L}\\p{N}\\p{M}_])"
        },
        {
          "name": "invalid.illegal.effect.elomar",
          "match": "[\\p{L}_][\\p{L}\\p{N}\\p{M}_]*"
        }
      ]
    },
    "use": {
      "match": "(?:\\b(use)|(?<![\\p{L}\\p{N}\\p{M}_])([اأإآٱ][\\p{Mn}ـ]*س[\\p{Mn}ـ]*ت[\\p{Mn}ـ]*خ[\\p{Mn}ـ]*د[\\p{Mn}ـ]*م[\\p{Mn}ـ]*)(?![\\p{L}\\p{N}\\p{M}_]))\\s+([\\p{L}_][\\p{L}\\p{N}\\p{M}_]*(?:\\.[\\p{L}_][\\p{L}\\p{N}\\p{M}_]*)*)",
      "captures": {
        "1": { "name": "keyword.other.import.elomar" },
        "2": { "name": "keyword.other.import.elomar" },
        "3": { "name": "entity.name.namespace.elomar" }
      }
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([\\p{L}_][\\p{L}\\p{N}\\p{M}_]*)",
          "captures": {
            "1": { "name": "storage.type.function.elomar" },
            "2": { "name": "entity.name.function.elomar" }
          }
        },
        {
          "match": "\\b(type|enum|trait)\\s+([\\p{L}_][\\p{L}\\p{N}\\p{M}_]*)",
          "captures": {
            "1": { "name": "storage.type.elomar" },
            "2": { "name": "entity.name.type.elomar" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.elomar",
          "match": "\\b(?:if|else|while|for|in|break|continue|return|match|await)\\b"
        },
        {
          "name": "storage.type.elomar",
          "match": "\\b(?:let|var|fn|type|enum|trait|impl)\\b"
        },
        {
          "name": "storage.modifier.elomar",
          "match": "\\b(?:pub|async)\\b"
        },
        {
          "name": "keyword.other.import.elomar",
          "match": "\\buse\\b"
        },
        {
          "name": "keyword.operator.word.elomar",
          "match": "\\bdiv\\b"
        },
        {
          "name": "variable.language.self.elomar",
          "match": "\\bself\\b"
        },
        {
          "name": "keyword.other.reserved.elomar",
          "match": "\\bas\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.elomar",
          "match": "\\b(?:true|false)\\b"
        },
        {
          "name": "constant.language.none.elomar",
          "match": "\\bNone\\b"
        },
        {
          "name": "support.function.constructor.elomar",
          "match": "\\b(?:Some|Ok|Err)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.builtin.elomar",
          "match": "\\b(?:Int|Float|Bool|String|Unit|Range|Duration|List|Map|Set|Option|Result|Future|AIError|FsError|JsonError|HttpError|DbError|PyError|McpError|ProcessError|HttpRequest|HttpResponse|Db)\\b"
        },
        {
          "comment": "Capitalized names are types, enums or their variants",
          "name": "entity.name.type.elomar",
          "match": "\\b\\p{Lu}[\\p{L}\\p{N}\\p{M}_]*\\b"
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "name": "support.function.builtin.elomar",
          "match": "\\b(?:print|input|to_float|to_int|to_string|parse_int|parse_float|assert_eq|assert|set|min|max|abs|all|timeout)\\b(?=\\s*\\()"
        },
        {
          "name": "entity.name.function.call.elomar",
          "match": "[\\p{L}_][\\p{L}\\p{N}\\p{M}_]*(?=\\s*(?:<[^<>()]*>)?\\s*\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.elomar",
          "match": "=>|->"
        },
        {
          "name": "keyword.operator.range.elomar",
          "match": "\\.\\.=?"
        },
        {
          "name": "keyword.operator.try.elomar",
          "match": "\\?"
        },
        {
          "name": "keyword.operator.comparison.elomar",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.elomar",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "punctuation.definition.parameters.closure.elomar",
          "match": "\\|"
        },
        {
          "name": "keyword.operator.assignment.elomar",
          "match": "[+\\-*/]?="
        },
        {
          "name": "keyword.operator.arithmetic.elomar",
          "match": "[+\\-*/%]"
        }
      ]
    }
  }
}
