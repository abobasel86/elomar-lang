{
  "name": "elomar-lang",
  "displayName": "Elomar-Lang",
  "description": "Elomar-Lang support: highlighting, errors while you type (Arabic/English), hover, go to definition, outline, completion, formatting, snippets and a Run button",
  "version": "1.16.0",
  "publisher": "abobasel86",
  "license": "MIT OR Apache-2.0",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#0f6e63",
    "theme": "dark"
  },
  "homepage": "https://abobasel86.github.io/elomar-lang/",
  "repository": {
    "type": "git",
    "url": "https://github.com/abobasel86/elomar-lang",
    "directory": "editor/vscode"
  },
  "bugs": {
    "url": "https://github.com/abobasel86/elomar-lang/issues"
  },
  "sponsor": {
    "url": "https://github.com/sponsors/abobasel86"
  },
  "keywords": [
    "elomar",
    "arabic",
    "عربي",
    "ai",
    "language server",
    "lsp",
    "debugger"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters",
    "Snippets"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "workspaceContains:**/*.elo",
    "onDebugResolve:elomar",
    "onDebugInitialConfigurations"
  ],
  "contributes": {
    "languages": [
      {
        "id": "elomar",
        "aliases": [
          "Elomar-Lang",
          "elomar"
        ],
        "extensions": [
          ".elo"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "elomar",
        "scopeName": "source.elomar",
        "path": "./syntaxes/elomar.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "elomar",
        "path": "./snippets/elomar.json"
      }
    ],
    "commands": [
      {
        "command": "elomar.run",
        "title": "Run File",
        "category": "Elomar",
        "icon": "$(play)"
      },
      {
        "command": "elomar.check",
        "title": "Check File",
        "category": "Elomar"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "elomar.run",
          "when": "editorLangId == elomar"
        }
      ],
      "commandPalette": [
        {
          "command": "elomar.run",
          "when": "editorLangId == elomar"
        },
        {
          "command": "elomar.check",
          "when": "editorLangId == elomar"
        }
      ]
    },
    "debuggers": [
      {
        "type": "elomar",
        "label": "Elomar-Lang",
        "languages": [
          "elomar"
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "program": {
                "type": "string",
                "description": "The .elo file to debug.",
                "default": "${file}"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Arguments for the program (`os.args()`).",
                "default": []
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Stop at the first statement of `main`.",
                "default": false
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "elomar",
            "request": "launch",
            "name": "Debug Elomar file",
            "program": "${file}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "Elomar-Lang: Debug file",
            "description": "Debug an .elo file with breakpoints (F5)",
            "body": {
              "type": "elomar",
              "request": "launch",
              "name": "Debug Elomar file",
              "program": "^\"\\${file}\""
            }
          }
        ]
      }
    ],
    "taskDefinitions": [
      {
        "type": "elomar",
        "required": [
          "file"
        ],
        "properties": {
          "file": {
            "type": "string",
            "description": "The .elo file to run"
          }
        }
      }
    ],
    "configurationDefaults": {
      "[elomar]": {
        "editor.formatOnSave": true,
        "editor.tabSize": 4,
        "editor.insertSpaces": true
      }
    },
    "configuration": {
      "title": "Elomar-Lang",
      "properties": {
        "elomar.path": {
          "type": "string",
          "default": "elomar",
          "description": "Path to the `elomar` executable, if it is not on PATH. Download it from https://github.com/abobasel86/elomar-lang/releases/latest"
        },
        "elomar.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "ar"
          ],
          "enumDescriptions": [
            "Follow VS Code's display language",
            "English",
            "العربية"
          ],
          "default": "auto",
          "description": "Language of error messages."
        },
        "elomar.checkOnType": {
          "type": "boolean",
          "default": true,
          "description": "Check while typing (otherwise only when a file is opened or saved)."
        }
      }
    },
    "breakpoints": [
      {
        "language": "elomar"
      }
    ]
  }
}
