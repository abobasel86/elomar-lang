{
  "main": {
    "prefix": "main",
    "body": ["fn main() {", "\t$0", "}"],
    "description": "Program entry point"
  },
  "async main": {
    "prefix": "amain",
    "body": ["async fn main() {", "\t$0", "}"],
    "description": "Async entry point (for await)"
  },
  "function": {
    "prefix": "fn",
    "body": ["fn ${1:name}(${2:x}: ${3:Int}) -> ${4:Int} {", "\t$0", "}"],
    "description": "Function"
  },
  "public function": {
    "prefix": "pfn",
    "body": ["pub fn ${1:name}(${2:x}: ${3:Int}) -> ${4:Int} !{${5}} {", "\t$0", "}"],
    "description": "Public function with declared effects"
  },
  "type": {
    "prefix": "type",
    "body": ["type ${1:Name} = {", "\t${2:field}: ${3:String}", "}"],
    "description": "Record type"
  },
  "enum": {
    "prefix": "enum",
    "body": ["enum ${1:Name} {", "\t${2:First}", "\t${3:Second}", "}"],
    "description": "Enum"
  },
  "trait": {
    "prefix": "trait",
    "body": ["trait ${1:Name} {", "\tfn ${2:method}(self) -> ${3:String}", "}"],
    "description": "Trait"
  },
  "impl": {
    "prefix": "impl",
    "body": ["impl ${1:Trait} for ${2:Type} {", "\tfn ${3:method}(self) -> ${4:String} {", "\t\t$0", "\t}", "}"],
    "description": "Implement a trait for a type"
  },
  "match result": {
    "prefix": "matchr",
    "body": ["match ${1:result} {", "\tOk(${2:value}) => $3", "\tErr(${4:e}) => $0", "}"],
    "description": "Match on a Result"
  },
  "match option": {
    "prefix": "matcho",
    "body": ["match ${1:option} {", "\tSome(${2:value}) => $3", "\tNone => $0", "}"],
    "description": "Match on an Option"
  },
  "test": {
    "prefix": "test",
    "body": ["fn test_${1:name}() {", "\tassert_eq(${2:actual}, ${3:expected})", "}"],
    "description": "Test function (in a file under tests/, run with `elomar test`)"
  },
  "for": {
    "prefix": "for",
    "body": ["for ${1:item} in ${2:items} {", "\t$0", "}"],
    "description": "For loop"
  },
  "if else": {
    "prefix": "ife",
    "body": ["if ${1:condition} {", "\t$2", "} else {", "\t$0", "}"],
    "description": "If / else"
  },
  "ai.infer": {
    "prefix": "infer",
    "body": [
      "await ai.infer<${1:T}>(",
      "\tmodel: \"${2:mock}\",",
      "\tinstructions: \"${3:Describe the task.}\",",
      "\tinput: ${4:text},",
      "\ttimeout: ${5:10s}",
      ")"
    ],
    "description": "Typed AI call (needs `use std.ai`)"
  },
  "read JSON file": {
    "prefix": "readjson",
    "body": [
      "match fs.read_text(\"${1:data/file.json}\") {",
      "\tOk(text) => match json.parse<${2:T}>(text) {",
      "\t\tOk(value) => $0",
      "\t\tErr(e) => print(\"bad JSON:\", e.message())",
      "\t}",
      "\tErr(e) => print(\"cannot read:\", e.message())",
      "}"
    ],
    "description": "Read and parse a JSON file (needs `use std.fs` and `use std.json`)"
  }
}
